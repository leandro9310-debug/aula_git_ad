programa
{
	funcao inicio()
	{
		inteiro numero
		escreva("Digite um número: ")
		leia(numero)
		
		escreva(eh_superior_a_dez(numero))
	}

	funcao logico eh_superior_a_dez(inteiro n)
	{
		retorne n > 10
	}
}


